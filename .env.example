QUANT_AGENT_APP_ENV=local
QUANT_AGENT_RUNTIME_MODE=RESEARCH
QUANT_AGENT_LOG_LEVEL=INFO
QUANT_AGENT_DATABASE_URL=sqlite:///./artifacts/quant_agent.db
QUANT_AGENT_RESEARCH_STORAGE_PATH=./artifacts/snapshots
QUANT_AGENT_MARKET_DATA_TOKEN_REF=env://MARKET_DATA_TOKEN
QUANT_AGENT_LLM_API_KEY_REF=env://LLM_API_KEY

# Set these in the process environment or a secret manager when the providers are used.
MARKET_DATA_TOKEN=
LLM_API_KEY=

